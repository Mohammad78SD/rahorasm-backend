# Copy to rahorasm/.env (next to manage.py) and fill in real values.
# Never commit the real .env file.

# --- Django core ---
# Long random string used for signing. Required.
SECRET_KEY=change-me
# Set to True only for local development. Defaults to False.
DEBUG=False
# Comma-separated hostnames the API may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Auth ---
# Signing key for JWT access/refresh tokens. Required.
JWT=change-me-too

# --- PostgreSQL ---
# Database name, user and password. Required.
DB_NAME=rahorasm
DB_USER=postgres
DB_PASSWORD=change-me
# Defaults: localhost / 5432
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache; stores OTP codes and signup data) ---
REDIS_URL=redis://127.0.0.1:6379/2

# --- CORS / CSRF ---
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Allow any origin (development only). Defaults to False.
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated origins trusted for CSRF (include scheme).
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Secure cookies need HTTPS; set both to False for plain-HTTP local development.
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# --- SMS provider (IPPanel) used to send OTP codes ---
IPPANEL_API_KEY=your-ippanel-api-key
# Sender line number
IPPANEL_ORIGINATOR=+983000505
# IPPanel pattern code for the OTP message (pattern variable: code)
IPPANEL_OTP_PATTERN=your-otp-pattern-code
# IPPanel pattern code for the generic notification helper (send_sms)
IPPANEL_NOTIFY_PATTERN=your-notify-pattern-code

# --- Files (optional; default to <project>/staticfiles and <project>/media) ---
# STATIC_ROOT=/var/www/rahorasm/static
# MEDIA_ROOT=/var/www/rahorasm/media
